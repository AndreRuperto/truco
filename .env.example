# Variáveis do servidor (apps/server). Detalhes de cada uma em docs/deploy-railway.md.
# Sem DATABASE_URL, o servidor usa PGlite em memória (desenvolvimento).
DATABASE_URL=
NODE_ENV=development
TRUCO_URL_PUBLICA=
RESEND_API_KEY=
TRUCO_EMAIL_REMETENTE=
GOOGLE_CLIENT_ID=
TRUCO_ORIGENS=
TRUCO_K_ELO=32
ADMIN_EMAILS=
# Pasta das vozes pessoais (voz clonada de conta), fora do Git; em produção, um volume do Railway.
VOZES_PESSOAIS_DIR=
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=15
